{
  "name": "examshell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-clang.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-clang.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:engine": "vitest run --project engine",
    "test:content": "vitest run --project content",
    "gen:expected": "python3 scripts/gen_expected.py",
    "gen:expected:wsl": "wsl python3 scripts/gen_expected.py",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-no-reference.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@yowasp/clang": "^22.0.0-git20695-13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
